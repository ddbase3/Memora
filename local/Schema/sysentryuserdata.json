{
	"name": "base3system_sysentryuserdata",
	"label": "Entry User Data",
	"description": "User-specific metadata and markers for entries such as stars, ownership, urgency or ratings",
	"domain": "xrm",
	"category": "access",
	"tags": ["user", "entry", "relation", "marker", "rating", "urgency", "favorite"],
	"fields": [
		{ "name": "user_id", "type": "integer", "label": "User ID", "required": true },
		{ "name": "entry_id", "type": "integer", "label": "Entry ID", "required": true },
		{ "name": "name", "type": "string", "label": "Attribute Name", "required": true },
		{ "name": "value", "type": "string", "label": "Attribute Value" }
	],
	"joins": [
		{
			"targetTable": "base3system_sysuser",
			"on": { "base3system_sysentryuserdata.user_id": "base3system_sysuser.id" },
			"type": "INNER",
			"meta": { "default": true }
		},
		{
			"targetTable": "base3system_sysentry",
			"on": { "base3system_sysentryuserdata.entry_id": "base3system_sysentry.id" },
			"type": "INNER",
			"meta": { "default": true }
		}
	],
	"defaultFilters": [],
	"position": { "x": 60, "y": 130 }
}
