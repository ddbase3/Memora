{
	"name": "base3system_sysallocview",
	"label": "XRM Allocation View",
	"description": "Symmetrische Sicht auf XRM Allocations. Jede Verbindung aus base3system_sysalloc erscheint bidirektional — über entry_id und peer_id.",
	"domain": "xrm",
	"category": "graph",
	"tags": ["graph", "allocation", "connection", "view"],
	"fields": [
		{
			"name": "id",
			"type": "integer",
			"label": "Allocation ID",
			"required": true,
			"description": "Allocation ID"
		},
		{
			"name": "entry_id",
			"type": "integer",
			"label": "Entry ID",
			"required": true,
			"description": "ID des aktuellen XRM-Eintrags (für Join-Verknüpfung)."
		},
		{
			"name": "peer_id",
			"type": "integer",
			"label": "Peer Entry ID",
			"required": true,
			"description": "ID des verbundenen Eintrags (andere Seite der Beziehung)."
		}
	],
	"joins": [
		{
			"targetTable": "base3system_sysentry",
			"on": { "base3system_sysallocview.entry_id": "base3system_sysentry.id" },
			"type": "INNER",
			"meta": { "default": true, "direction": "forward" }
		},
		{
			"targetTable": "base3system_sysentry",
			"on": { "base3system_sysallocview.peer_id": "base3system_sysentry.id" },
			"type": "INNER",
			"meta": { "direction": "reverse" }
		}
	],
	"defaultFilters": [],
	"position": { "x": 730, "y": 300 }
}

