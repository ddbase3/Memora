{
	"name": "base3system_sysmetadata",
	"label": "System Metadata",
	"description": "Key/value metadata linked to entries (one entry can have many metadata keys).",
	"domain": "xrm",
	"category": "system",
	"tags": ["metadata", "entry", "keyvalue", "json"],
	"fields": [
		{ "name": "entry_id", "type": "integer", "label": "Entry ID", "required": true },
		{ "name": "name", "type": "string", "label": "Metadata Key", "required": true },
		{ "name": "data", "type": "text", "label": "Metadata Value", "required": true }
	],
	"joins": [
		{
			"targetTable": "base3system_sysentry",
			"on": { "base3system_sysmetadata.entry_id": "base3system_sysentry.id" },
			"type": "INNER",
			"meta": { "default": true }
		}
	],
	"defaultFilters": [],
	"position": { "x": 760, "y": 520 }
}
