{
	"name": "base3system_entryproject",
	"label": "XRM Data Project",
	"description": "Project and work package data records for XRM entries",
	"domain": "xrm",
	"category": "data",
	"tags": ["project", "task", "work", "entry"],
	"fields": [
		{ "name": "id", "type": "integer", "label": "Project ID", "required": true },
		{ "name": "projid", "type": "string", "label": "Project code", "required": false },
		{ "name": "alias", "type": "string", "label": "Project alias", "required": false },
		{ "name": "name", "type": "string", "label": "Project name", "required": true },
		{ "name": "description", "type": "text", "label": "Project description", "required": false },
		{ "name": "start", "type": "date", "label": "Project start date", "required": false },
		{ "name": "deadline", "type": "date", "label": "Project deadline", "required": false },
		{ "name": "expense", "type": "integer", "label": "Project expense estimate", "required": false }
	],
	"joins": [
		{
			"targetTable": "base3system_sysentry",
			"on": { "base3system_entryproject.id": "base3system_sysentry.id" },
			"type": "INNER",
			"meta": { "default": true }
		}
	],
	"defaultFilters": [],
	"position": { "x": 0, "y": 0 }
}

