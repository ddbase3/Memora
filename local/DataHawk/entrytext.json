{
	"name": "base3system_entrytext",
	"label": "XRM Data Text",
	"description": "Text and content data records for XRM entries",
	"domain": "xrm",
	"category": "data",
	"tags": ["text", "content", "note", "entry"],
	"fields": [
		{ "name": "id", "type": "integer", "label": "Text ID", "required": true },
		{ "name": "name", "type": "string", "label": "Text name", "required": true },
		{ "name": "text", "type": "text", "label": "Text content", "required": true },
		{ "name": "mime", "type": "string", "label": "MIME type", "required": false }
	],
	"joins": [
		{
			"targetTable": "base3system_sysentry",
			"on": { "base3system_entrytext.id": "base3system_sysentry.id" },
			"type": "INNER",
			"meta": { "default": true }
		}
	],
	"defaultFilters": [],
	"position": { "x": 0, "y": 0 }
}

